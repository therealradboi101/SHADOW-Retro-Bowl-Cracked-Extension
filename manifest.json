{
  "manifest_version": 3,
  "name": "S.H.A.D.O.W - Retro Bowl Cracker",
  "version": "1.0",
  "description": "Cracked client for retro bowl credits, salary cap, draft picks, and more!",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "S.H.A.D.O.W"
  },
  "web_accessible_resources": [
    {
      "resources": ["retrobowl.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://game316009.konggames.com/gamez/0031/6009/live/index.html",
        "https://www.retrobowl.me/*",
        "https://retrobowl.me/*",
        "https://www.retrobowl.app/*",
        "https://retrobowl.app/*",
        "https://blobby-boi.github.io/retro-bowl/*"
      ],
      "js": ["shadow.js"],
      "run_at": "document_end"
    }
  ]
}